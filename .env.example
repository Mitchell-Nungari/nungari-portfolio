# ---------------------------------------------------------------------------
# AI discovery (step 2) — Google Gemini free tier
# https://aistudio.google.com/apikey
#
# Discovery reads the public listing pages itself (netlify/lib/sources.mjs);
# Gemini is only used to read plain-HTML pages, with no tools and no Search
# grounding, so there is no grounding quota to worry about.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Optional — the model to use (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional — the models to fall back to, in order, when a call fails
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Optional — how long one Gemini attempt may take, in milliseconds
# (default: 40000)
GEMINI_TIMEOUT_MS=40000

# Optional — how many new events one run may add to pending (default: 6)
MAX_EVENTS=6

# Optional — how long the whole run may take, in milliseconds
# (default: 240000 — 4 minutes)
DISCOVER_DEADLINE_MS=240000

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Shared secret for POST /.netlify/functions/discover (starts a run) and for
# the background function that does the work.
DISCOVER_KEY=change-me

# Admin login (step 4)
ADMIN_PASSWORD=change-me
ADMIN_SECRET=change-me

# ---------------------------------------------------------------------------
# For scripts/seed-events.mjs (pushes straight to a deployed site)
# ---------------------------------------------------------------------------
SITE_ID=
NETLIFY_AUTH_TOKEN=
